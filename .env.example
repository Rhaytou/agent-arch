# ============================================================
# ENVIRONMENT VARIABLES — copy to .env and fill in your values
# ============================================================

# PostgreSQL / pgvector
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agent_db

# Redis
REDIS_PASSWORD=changeme

# Ollama
OLLAMA_MODELS=llama3.2:1b,llama3.2:3b,phi3:mini,gemma2:2b,qwen2.5:3b
OLLAMA_KEEP_ALIVE=5m

# LiteLLM
LITELLM_MASTER_KEY=sk-changeme           # master key agents use to call LiteLLM

# External LLM providers — leave empty if not using
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# n8n
N8N_ENCRYPTION_KEY=changeme-32-char-secret-key
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678
TIMEZONE=UTC



